cc_binary {
    name: "android.hardware.lights-service.sdm710",
    relative_install_path: "hw",
    init_rc: ["android.hardware.lights.sdm710.rc"],
    vintf_fragments: ["android.hardware.lights.sdm710.xml"],
    vendor: true,
    shared_libs: [
        "libbase",
        "liblog",
        "libhardware",
        "libbinder_ndk",
        "android.hardware.light-V1-ndk",
    ],
    srcs: [
        "Lights.cpp",
        "main.cpp",
    ],
}
